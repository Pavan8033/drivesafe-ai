rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document: only the authenticated user can read or write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User monitoring sessions subcollection: strict user ownership
      match /sessions/{sessionId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.sessionId is string
          && request.resource.data.durationSeconds is number
          && request.resource.data.drowsinessEventCount is number
          && request.resource.data.sessionStatus in ['ACTIVE', 'COMPLETED', 'INTERRUPTED'];

        // Session events subcollection
        match /events/{eventId} {
          allow read, delete: if request.auth != null && request.auth.uid == userId;
          allow create, update: if request.auth != null && request.auth.uid == userId
            && request.resource.data.type is string
            && request.resource.data.durationMs is number;
        }
      }
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
